\begin{frame}
\frametitle{Efficient Tracer Tool for CCS monitoring}

\phantom{u}\\[2ex]

\begin{itemize}
\setlength{\itemsep}{3ex}
% \item miniRUEDI + GE-MIMS provides continuous and efficient gas monitoring in CCS system

\item He (or other noble gases) are useful tracers for efficient, continuous monitoring of \ce{CO2} and fluids in CCS systems.

\item Shallow well near injection shows no signs\\ of \ce{CO2} or tracer He from the injection.

\item Deep well \SI{100}{m} downstream of injection:\\[2ex]
  \begin{itemize}
  \setlength{\itemsep}{1.2ex}
  \item He tracer indicates arrival of injection fluid.
  \item \ce{CO2} remains close to natural background.
  \end{itemize}

\end{itemize}

\end{frame}


